{
  "name": "healer-deckbuilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototype for the Healer Deckbuilder core battle loop.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx scripts/run-tests.ts",
    "test:content": "tsx scripts/run-tests.ts content",
    "validate": "tsx scripts/validate.ts",
    "sim": "tsx sim/run-sim.ts",
    "coverage": "tsx sim/exercise.ts",
    "trace": "tsx sim/trace.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
